# ============================================================
# CreatorNE App — Environment Variables (Placeholder)
# ============================================================
# Replace these with your actual values from Supabase & Meta

# Supabase — Get from: Supabase Dashboard → Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Backend API — Your Next.js web backend URL
# Local dev: http://localhost:3000
# Production: https://your-domain.com
EXPO_PUBLIC_API_URL=http://localhost:3000

# Instagram — Get from: Meta Developer Dashboard → Instagram Basic Display
EXPO_PUBLIC_INSTAGRAM_APP_ID=your-instagram-app-id
